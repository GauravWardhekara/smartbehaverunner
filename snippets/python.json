  "Behave @fixture generator": {
    "prefix": ["fixture", "@fixture"],
    "body": [
      "from behave import fixture, use_fixture",
      "",
      "@fixture",
      "def ${1:browser_fixture}(context, *args, **kwargs):",
      "    # Setup",
      "    ${2:client = setup_client()}",
      "    context.${3:client} = ${2:client}",
      "    yield ${2:client}",
      "    # Teardown / Cleanup",
      "    ${0:pass}"
    ],
    "description": "Behave scoped fixture generator function (@fixture)"
