  },
  "Behave register_type": {
    "prefix": ["register_type"],
    "body": [
      "from behave import register_type",
      "",
      "def parse_${1:type_name}(text):",
      "    \"\"\"Custom Behave type converter for {param:${1:type_name}}\"\"\"",
      "    return ${2:text.strip()}",
      "",
      "register_type(${1:type_name}=parse_${1:type_name})"
    ],
    "description": "Register custom type converter for Behave parse matcher"
  },
  "Behave environment.py template": {
    "prefix": ["behave_environment", "environment.py"],
    "body": [
      "# -*- coding: utf-8 -*-",
      "\"\"\"Behave test lifecycle environment hooks and fixtures.\"\"\"",
      "from behave import fixture, use_fixture",
      "",
      "def before_all(context):",
      "    \"\"\"Runs once before any feature or scenario executes.\"\"\"",
      "    ${1:context.config.setup_logging()}",
      "",
      "def before_feature(context, feature):",
      "    \"\"\"Runs before each feature file is evaluated.\"\"\"",
      "    pass",
      "",
      "def before_scenario(context, scenario):",
      "    \"\"\"Runs before each scenario executes.\"\"\"",
      "    pass",
      "",
      "def before_step(context, step):",
      "    \"\"\"Runs before each step executes.\"\"\"",
      "    pass",
      "",
      "def after_step(context, step):",
      "    \"\"\"Runs after each step executes.\"\"\"",
      "    if step.status == \"failed\":",
      "        pass",
      "",
      "def after_scenario(context, scenario):",
      "    \"\"\"Runs after each scenario executes.\"\"\"",
      "    pass",
      "",
      "def after_feature(context, feature):",
      "    \"\"\"Runs after each feature file completes.\"\"\"",
      "    pass",
      "",
      "def after_all(context):",
      "    \"\"\"Runs once after all features have finished execution.\"\"\"",
      "    pass",
      "",
      "def before_tag(context, tag):",
      "    \"\"\"Runs before tags to attach fixtures or conditional setup.\"\"\"",
      "    pass",
      "",
      "def after_tag(context, tag):",
      "    \"\"\"Runs after tagged entities complete.\"\"\"",
      "    pass"
    ],
    "description": "Complete Behave environment.py lifecycle hooks boilerplate"
  },
